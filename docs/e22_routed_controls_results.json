  "harness": "\"\"\"One fixed comparison after split-state, CUDA-noise and cadence fixes.\"\"\"\nimport argparse\nimport hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nimport torch\n\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--initialization\", choices=(\"api\", \"conformance\"), required=True)\nparser.add_argument(\"--output\", required=True)\nargs = parser.parse_args()\nroot = Path(\"/ml2/hypergan/ParticleGAN-pr155-merge\")\nsys.path.insert(0, str(root / \"examples\"))\nimport e22_routed_sites as task\n\ntorch.set_num_threads(1)\nsource_paths = sorted(root.glob(\"particlegan/**/*.py\")) + [root / \"examples/e22_routed_sites.py\"]\nhashes = {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest()\n          for path in source_paths}\nreceipt = dict(\n    purpose=\"Fixed revalidation after half/quarter Adam transport and CUDA learned-noise repair; no seed or hyperparameter sweep\",\n    source_base_revision=subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=root, text=True).strip(),\n    source_changes=\"Working-tree implementation identified by source_sha256, committed with this receipt\",\n    source_sha256=hashes, hardware=torch.cuda.get_device_name(), torch_version=torch.__version__,\n    device=\"cuda:0 (CUDA_VISIBLE_DEVICES=1)\", initialization=args.initialization,\n    timing_note=\"Synchronized update-only elapsed times on a shared GPU; other workloads were active. Not an isolated hardware throughput benchmark or comparable to earlier dedicated-device times.\",\n    shape=dict(tokens=128, particles=128, z_dim=4, batch_size=8), updates=40, warmup_steps=1,\n    harness=Path(__file__).read_text(),\n    command=f\"PYTHONPATH=. CUDA_VISIBLE_DEVICES=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 /tmp/pr155-e22-venv/bin/python -u /tmp/pr155-final-routed-comparison.py --initialization {args.initialization} --output {args.output}\",\n)\narms = [(\"frozen\", \"frozen\", {}), (\"movable_no_rows\", \"no_rows\", {}),\n        (\"full\", \"full\", {}), (\"full_output_guard\", \"full\", {\"output_error_guard\": True}),\n        (\"full_probe_interval_20\", \"full\", {\"probe_interval\": 20})]\nreports, reference_weights, reference_inputs = [], None, None\nfor label, mode, options in arms:\n    loop = task.make_loop(mode=mode, device=\"cuda:0\", initialization=args.initialization,\n                          tokens=128, z_dim=4, particles=128, batch_size=8, **options)\n    weights = {f\"{name}.{key}\": value.detach().clone()\n               for name, model in loop.policy._training_modules().items()\n               for key, value in model.state_dict().items()}\n    weights.update(table=loop.policy.table.detach().clone(),\n                   output_sigma=loop.policy.log_output_sigma.detach().clone())\n    if reference_weights is None:\n        reference_weights = weights\n    else:\n        assert weights.keys() == reference_weights.keys()\n        assert all(torch.equal(value, reference_weights[key]) for key, value in weights.items())\n    print(json.dumps(dict(event=\"arm_begin\", arm=label, initialization=args.initialization)), flush=True)\n    report, inputs = task.train(loop, 40, log_every=20, warmup_steps=1)\n    if reference_inputs is None:\n        reference_inputs = inputs\n    else:\n        assert inputs == reference_inputs, \"Matched initialization, batches, paired draws and DV12 states required\"\n    report.update(arm=label, final_output_sigma=loop.policy.output_sigma(),\n                  probe_clock=loop.policy.routed_control.probe_clock,\n                  matched_inputs_sha256=hashlib.sha256(json.dumps(inputs).encode()).hexdigest())\n    reports.append(report)\n    del loop\n\nassert hashes == {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest()\n                  for path in source_paths}, \"Source changed during measured comparison\"\nreceipt.update(matched_initial_parameters=True, matched_batches_and_base_noise=True,\n               matched_dv12_draw_schedule=True, dv12_draws_per_update=4,\n               dv12_draw_shape=[1024, 4], reports=reports)\nPath(args.output).write_text(json.dumps(receipt, indent=2) + \"\\n\")\nprint(json.dumps(dict(event=\"comparison_receipt\", path=args.output,\n                     reports=[{key: row[key] for key in (\"arm\", \"heldout_rmse\", \"heldout_max_error\", \"training_seconds\", \"final_output_sigma\")}\n                              | row[\"row_diagnostics\"][\"counters\"] for row in reports])), flush=True)\n",
