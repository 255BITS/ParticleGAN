!/reports/**/current-recipes.json
!/reports/**/previous-recipes.json
!/reports/**/reference_profile.json
!/reports/**/plan.json
!/reports/**/*_plan.json

# Console output and duplicate metric streams stay in local research runs.
/reports/toy100/**/*.log
/reports/toy100/**/*.log.gz
/reports/toy100/**/metrics.jsonl

# Raw research logs belong in local/artifact storage, not the source tree.
/reports/**/*.log
/reports/**/*.log.gz
/reports/**/*.jsonl
/reports/**/*.xml
/reports/**/metrics.json
/reports/**/state-diagnosis.json
/reports/**/initial-state-diagnosis.json
/reports/**/diagnosis-anchor-posterior.json
/reports/**/*.out
# Large JSON boards duplicate compact receipts and are regenerated by Forge.
/reports/forge/leaderboards/*.json
# Full new Forge execution envelopes contain per-update diagnostics. Preserve
# them locally/in artifact archives; publish compact technique-receipts instead.
# Existing tracked historical envelopes retain their original Git identities.
/reports/forge/attempts/

