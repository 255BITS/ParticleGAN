# Console output and duplicate metric streams stay in local research runs.
/reports/toy100/**/*.log
/reports/toy100/**/*.log.gz
/reports/toy100/**/metrics.jsonl

# Raw research logs belong in local/artifact storage, not the source tree.
/reports/**/*.log
/reports/**/*.log.gz
/reports/**/*.jsonl
/reports/**/*.xml
/reports/**/metrics.json
/reports/**/state-diagnosis.json
/reports/**/initial-state-diagnosis.json
/reports/**/diagnosis-anchor-posterior.json
/reports/**/*.out
# Large JSON boards duplicate compact receipts and are regenerated by Forge.
/reports/forge/leaderboards/*.json
