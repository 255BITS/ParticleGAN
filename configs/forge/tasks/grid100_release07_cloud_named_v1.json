{
  "schema_version": 1,
  "id": "grid100_release07_cloud_named_v1",
  "adapter": "native100",
  "execution": {
    "problem": "grid100",
    "steps": 7000,
    "prior": {
      "kind": "particle_cloud",
      "sigma": 0,
      "standardize": false,
      "learnable": true,
      "exception_reason": "Faithful v0.7.0 GAN v3 public ParticlePrior law; sigma_rel and standardize are inert on its particle branch. Separate diagnostic, no MoG qualification."
    },
    "protocol": "screening",
    "produces_state": true,
    "native_profile": {
      "id": "release07_public_default_named_v1",
      "revision": 1,
      "source": {
        "path": "configs/toy100/release07_public_default_host.json",
        "sha256": "aa6c8d2ab22682dfeae90e829d58c0aab8a0626aa39722cbde12156e7569894e"
      }
    },
    "host_definition": {
      "generator": {
        "kind": "simple_mlp",
        "z_dim": 4,
        "hidden_dim": 128,
        "n_hidden": 3,
        "out_dim": 2
      },
      "discriminator": {
        "kind": "simple_mlp",
        "in_dim": 2,
        "hidden_dim": 128,
        "n_hidden": 3,
        "fourier": 2
      },
      "resources": {
        "z_dim": 4,
        "num_particles": 20000,
        "batch_size": 256
      },
      "initialization": {
        "generator": {
          "method": "xavier_uniform_zero_bias_v1",
          "gain": 1.0
        },
        "discriminator": {
          "method": "xavier_uniform_zero_bias_v1",
          "gain": 1.0
        },
        "prior": {
          "method": "sample_distributions_v1",
          "parameters": {
            "z": {
              "kind": "normal",
              "mean": 0.0,
              "std": 1.0
            }
          }
        }
      }
    }
  },
  "evaluation": {
    "sampling_contract_version": 1,
    "sampling_law": "public_prior_without_output_noise",
    "eval_output_noise": "clean",
    "kind": "native_accuracy",
    "evaluator": "benchmarks.toy100.accuracy_gate:evaluate_suite",
    "coverage_evaluator": "benchmarks.toy100.gate:evaluate_suite",
    "scoring_weights": "live",
    "eval_interval": 250,
    "early_eval_steps": [
      0,
      1,
      10,
      25,
      50,
      100
    ],
    "eval_samples": 20000,
    "minimum_stable_checks": 5,
    "holdout_samples": 100000,
    "coverage_thresholds": {
      "min_samples": 20000,
      "min_modes": 100,
      "min_hq_mode_mass": 0.005,
      "min_precision": 0.97,
      "max_mass_tv": 0.1,
      "max_mode_mass": 0.02,
      "min_cov_eig_ratio": 0.4,
      "max_cov_eig_ratio": 1.7,
      "min_radial_median_ratio": 0.65,
      "max_radial_median_ratio": 1.4,
      "all_finite": true
    },
    "accuracy_limits": {
      "mass_tv": 0.06,
      "center_rms_sigma": 0.2,
      "abs_cov_trace_bias": 0.1,
      "radial_ks": 0.04
    },
    "sources": {
      "benchmarks/toy100/gate.py": "2ddadf56a4ccd7645c8b4e391373818b1113fb6113a9c691310fb162684058e6",
      "benchmarks/toy100/accuracy_gate.py": "e66ede95d4b80eedd832a102841c2b0a5d6d710f646bfa34dc00647dc0ab3abe",
      "benchmarks/toy100/metrics.py": "a7fbef19082f8470eb392948da52a336a90a3e99c6b3b893343a9e75bcda9c7b",
      "benchmarks/toy100/accuracy.py": "ee5c62049f8cdceb3d93b6d792cbaa96c815e12b3ce79ffaed244fb15a44fed2"
    },
    "paired_output_noise_diagnostic": {
      "version": 1,
      "sampling_law": "public_recipe_scheduled_output_noise",
      "base_draws": "same_required_clean_samples",
      "scoring_weights": [
        "live",
        "ema"
      ],
      "checks": "all_declared_and_independent_holdout",
      "qualification_reuse": false,
      "noise_rng": "named_eval_output_noise_per_model_and_holdout"
    },
    "evaluator_revision": {
      "id": "native100-manifest-sampling-v2",
      "previous_gate_sha256": "55f6ef733f0b10f4c6ac05eb5ad9d30320d807ff520ea1b41c75d2d0b41e406a",
      "change": "Validate explicit CLI evaluation-noise overrides; metric kernels, thresholds, clean sampling law and budgets unchanged."
    }
  },
  "resources": {
    "gpus": 1,
    "gpu_memory_mb": 2048,
    "cpu_threads": 1,
    "timeout_seconds": 3600
  },
  "requires_capabilities": [
    "checkpoint",
    "named_rng",
    "live_sampling",
    "learned_locations",
    "particle_cloud"
  ],
  "dependencies": []
}
