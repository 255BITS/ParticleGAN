{
  "schema_version": 1,
  "id": "ring16_bigan_continuous",
  "description": "Continuous 2D multimodal joint (G(z), E(x), D(x, z)) on 16-Gaussian ring with MoGParticlePrior(sigma=0.1).",
  "adapter": "transfer_vector",
  "execution": {
    "initializer": "deterministic_orthogonal",
    "host": "ring16_bigan_continuous",
    "steps": 4000,
    "prior": {
      "kind": "mog",
      "sigma": 0.1,
      "standardize": false
    },
    "protocol": "screening",
    "produces_state": true,
    "host_definition": {
      "target": "16-Gaussian ring",
      "radius": 3.0,
      "sigma": 0.1,
      "modes": 16,
      "steps": 4000,
      "batch": 128,
      "z_dim": 2,
      "particles": 256
    },
    "prior_contract": "recipe_owned_v1"
  },
  "evaluation": {
    "sampling_contract_version": 1,
    "sampling_law": "public_prior_without_output_noise",
    "eval_output_noise": "clean",
    "kind": "ring16_bigan_continuous",
    "eval_samples": 4096,
    "thresholds": [
      ["modes", ">=", 16],
      ["hq", ">=", 0.85],
      ["mass_tv", "<=", 0.15],
      ["recon_rmse", "<=", 0.12],
      ["mode_consistency", ">=", 0.98]
    ]
  },
  "resources": {
    "gpus": 1,
    "gpu_memory_mb": 2048,
    "cpu_threads": 1,
    "timeout_seconds": 600
  },
  "requires_capabilities": [
    "checkpoint",
    "named_rng",
    "live_sampling",
    "mog_prior"
  ],
  "dependencies": []
}
