+"""Training-gradient coherence with fixed eight-batch history and positive weight floor.
+
+No samples, targets, critic scores, task IDs, update deadlines or evaluator enter here.
+The effective count describes EMA weights, not independent statistical observations.
+"""
+from copy import deepcopy
+import math
+import torch
+
+
+class GradientCoherence:
+    mode = 'gradient_coherence'
+    beta = 7 / 8
+
+    def __init__(self):
+        self.packet = None
+        self.response = dict(applied_steps=0)
+
+    @torch.no_grad()
+    def observe(self, gradients):
+        gradients = [g.detach().double() for g in gradients]
+        if not gradients or any(not bool(torch.isfinite(g).all()) for g in gradients):
+            raise ValueError('finite training gradients required')
+        if self.packet is None:
+            self.packet = dict(means=[torch.zeros_like(g) for g in gradients],
+                               second=gradients[0].new_zeros(()), weight=0., weight2=0., count=0, last={})
+        s = self.packet
+        if len(s['means']) != len(gradients) or any(m.shape != g.shape for m, g in zip(s['means'], gradients)):
+            raise ValueError('gradient layout changed')
+        alpha = 1 - self.beta
+        s['means'] = [self.beta*m + alpha*g for m, g in zip(s['means'], gradients)]
+        s['second'] = self.beta*s['second'] + alpha*sum(g.square().sum() for g in gradients)
+        s['weight'] = self.beta*s['weight'] + alpha
+        s['weight2'] = self.beta**2*s['weight2'] + alpha**2
+        s['count'] += 1
+        effective = s['weight']**2 / s['weight2']
+        mean2 = sum((m / s['weight']).square().sum() for m in s['means'])
+        second = s['second'] / s['weight']
+        coherence = float((mean2 / second).clamp(0, 1)) if bool(second > 0) else 0.
+        gain = max(1 / effective, coherence)
+        gain = min(1., gain)
+        if not math.isfinite(gain) or not 0 < gain <= 1:
+            raise ValueError('invalid gradient coherence gain')
+        s['last'] = dict(gain=gain, coherence=coherence, effective_weight_count=effective,
+                         mean_square=float(mean2), second_moment=float(second))
+        return gain
+
+    def state_dict(self):
+        return deepcopy(dict(schema=1, mode=self.mode, beta=self.beta, packet=self.packet, response=self.response))
+
+    def validate(self, value, parameters):
+        if (not isinstance(value, dict) or set(value) != {'schema','mode','beta','packet','response'}
+                or value['schema'] != 1 or value['mode'] != self.mode or value['beta'] != self.beta):
+            raise ValueError('gradient response checkpoint identity mismatch')
+        if not isinstance(value['response'], dict) or set(value['response']) != {'applied_steps'}:
+            raise ValueError('gradient response checkpoint counters malformed')
+        count = value['response']['applied_steps']
+        if type(count) is not int or count < 0:
+            raise ValueError('gradient response checkpoint counters invalid')
+        s = value['packet']
+        if s is None:
+            if count:
+                raise ValueError('gradient response missing initialized history')
+            return
+        if (set(s) != {'means','second','weight','weight2','count','last'} or type(s['count']) is not int
+                or s['count'] != count or count < 1 or len(s['means']) != len(parameters)):
+            raise ValueError('gradient response history/counters inconsistent')
+        for name, expected in [('weight',1-self.beta**count), ('weight2',(1-self.beta)**2*(1-self.beta**(2*count))/(1-self.beta**2))]:
+            if type(s[name]) not in (int,float) or not math.isfinite(s[name]) or abs(s[name]-expected)>1e-12:
+                raise ValueError('gradient response weight history invalid')
+        tensors = s['means'] + [s['second']]
+        if any(not isinstance(t,torch.Tensor) or t.dtype != torch.float64 or not bool(torch.isfinite(t).all()) for t in tensors):
+            raise ValueError('gradient response tensor history invalid')
+        if s['second'].numel()!=1 or bool(s['second']<0) or any(m.shape!=p.shape for m,p in zip(s['means'],parameters)):
+            raise ValueError('gradient response parameter layout invalid')
+        last=s['last']
+        if (not isinstance(last,dict) or set(last)!={'gain','coherence','effective_weight_count','mean_square','second_moment'}
+                or any(type(v) not in (int,float) or not math.isfinite(v) for v in last.values())
+                or not 0<last['gain']<=1 or not 0<=last['coherence']<=1):
+            raise ValueError('gradient response receipt invalid')
+
+    def load(self, value, parameters):
+        self.validate(value, parameters)
+        value=deepcopy(value)
