diff --git a/tests/test_precision_lr_helpers.py b/tests/test_precision_lr_helpers.py
new file mode 100644
--- /dev/null
+++ b/tests/test_precision_lr_helpers.py
@@ -0,0 +1,118 @@
+"""Public LR contracts only: no forwards, gradients or optimizer updates."""
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+import torch
+from torch import nn
+
+import particlegan
+from particlegan import (
+    GANTrainer, NetworkLRTransition, ReversiblePrecision, get_recipe,
+    learning_rate_scales, scale_learning_rates,
+)
+
+
+def continuous_recipe(**overrides):
+    return get_recipe(**dict(total_steps=None, continuous_precision="rp5",
+                             game_update="secant_resolvent", adam_eager_state=True,
+                             num_particles=8, z_dim=2, **overrides))
+
+
+def optimizer_fixture():
+    generator, critic, prior = nn.Linear(2, 2), nn.Linear(2, 1), nn.Embedding(8, 2)
+    opt_g = torch.optim.Adam([
+        {"params": generator.parameters(), "lr": .00425},
+        {"params": prior.parameters(), "lr": .0085},
+    ])
+    opt_d = torch.optim.Adam(critic.parameters(), lr=.00425)
+    return (opt_g, opt_d), [[.00425, .0085], [.00425]], prior
+
+
+def rates(optimizers):
+    return [[g["lr"] for g in opt.param_groups] for opt in optimizers]
+
+
+def test_tests_use_the_scratch_package():
+    assert Path(particlegan.__file__).resolve().parent == Path(__file__).resolve().parents[1] / "particlegan"
+
+
+@pytest.mark.parametrize("opened,expected", [(True, (1., 1.)), (False, (.01, .05))])
+def test_helpers_read_the_trainer_controller_at_any_age_without_advancing(opened, expected):
+    trainer = GANTrainer(continuous_recipe(), nn.Linear(2, 2), nn.Linear(2, 1),
+                         serial_backward=True, optimizer_options={"foreach": False, "fused": False})
+    trainer.precision.state["open"] = opened
+    before = deepcopy(trainer.precision.state)
+    reference = {k: v.clone() for k, v in trainer.precision.reference.state_dict().items()}
+    for age in (0, 720, 7000, 30000, 10**9):
+        assert learning_rate_scales(age, trainer.recipe, precision=trainer.precision) == expected
+        assert expected == trainer.precision.scales()
+    assert trainer.precision.state == before
+    assert all(torch.equal(v, trainer.precision.reference.state_dict()[k]) for k, v in reference.items())
+    assert trainer.completed_steps == 0
+
+
+def test_inactive_finite_schedule_fields_do_not_change_continuous_scales():
+    controller = ReversiblePrecision(nn.Linear(2, 1), variant="rp5")
+    controller.state["open"] = False
+    for recipe in (continuous_recipe(), continuous_recipe(
+            lr_anneal_start=.1, lr_floor=.9, network_lr_floor=.8, network_lr_horizon_cap=2)):
+        assert learning_rate_scales(10**9, recipe, precision=controller) == (.01, .05)
+
+
+def test_rate_application_splits_roles_without_compounding_and_can_reopen():
+    recipe = continuous_recipe()
+    controller = ReversiblePrecision(nn.Linear(2, 1), variant="rp5")
+    optimizers, base, prior = optimizer_fixture()
+    controller.state["open"] = False
+    for age in (500, 501):
+        assert scale_learning_rates(age, recipe, optimizers, base, prior, precision=controller) == (.01, .05)
+        assert rates(optimizers) == [[.00425 * .01, .0085 * .05], [.00425 * .01]]
+    controller.state["open"] = True
+    scale_learning_rates(502, recipe, optimizers, base, prior, precision=controller)
+    assert rates(optimizers) == base
+    assert all(not opt.state for opt in optimizers)
+
+
+@pytest.mark.parametrize("controller,error,message", [
+    (None, ValueError, "requires a matching ReversiblePrecision"),
+    (object(), TypeError, "must be a ReversiblePrecision"),
+    ("rp1", ValueError, "variant does not match"),
+    ("rp4", ValueError, "variant does not match"),
+])
+def test_invalid_controller_rejected_before_optimizer_mutation(controller, error, message):
+    if isinstance(controller, str):
+        controller = ReversiblePrecision(nn.Linear(2, 1), variant=controller)
+    recipe = continuous_recipe()
+    optimizers, base, prior = optimizer_fixture()
+    before = rates(optimizers)
+    with pytest.raises(error, match=message):
+        learning_rate_scales(123, recipe, precision=controller)
+    with pytest.raises(error, match=message):
+        scale_learning_rates(123, recipe, optimizers, base, prior, precision=controller)
+    assert rates(optimizers) == before
+
+
+def test_controller_and_caller_transition_cannot_select_two_schedules():
+    controller = ReversiblePrecision(nn.Linear(2, 1), variant="rp5")
+    transition = NetworkLRTransition(4, start_step=8)
+    optimizers, base, prior = optimizer_fixture()
+    with pytest.raises(ValueError, match="cannot use network_transition"):
+        scale_learning_rates(12, continuous_recipe(), optimizers, base, prior,
+                             precision=controller, network_transition=transition)
+    assert rates(optimizers) == base
+    with pytest.raises(ValueError, match="requires a continuous-precision recipe"):
+        learning_rate_scales(12, get_recipe(total_steps=20), precision=controller)
+
+
+@pytest.mark.parametrize("age,expected", [
+    (0, (1., 1.)), (10, (.2, 1.)), (15, (.2, .55)), (20, (.2, .1)), (50, (.2, .1)),
+])
+def test_finite_recipe_closed_form_behavior_and_group_application_are_unchanged(age, expected):
+    recipe = get_recipe(total_steps=20, network_lr_horizon_cap=10,
+                        network_lr_floor=.2, lr_floor=.1, lr_anneal_start=.5)
+    assert learning_rate_scales(age, recipe) == pytest.approx(expected)
+    optimizers, base, prior = optimizer_fixture()
+    assert scale_learning_rates(age, recipe, optimizers, base, prior) == pytest.approx(expected)
+    assert rates(optimizers)[0] == pytest.approx([.00425 * expected[0], .0085 * expected[1]])
+    assert rates(optimizers)[1] == pytest.approx([.00425 * expected[0]])
