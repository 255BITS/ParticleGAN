diff --git a/tests/test_precision_probe.py b/tests/test_precision_probe.py
new file mode 100644
--- /dev/null
+++ b/tests/test_precision_probe.py
@@ -0,0 +1,112 @@
+"""Tiny CPU probe contracts; no optimizer steps or training loop."""
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+import torch
+from torch import nn
+
+import particlegan
+from particlegan.precision import ReversiblePrecision
+
+
+class ContextCritic(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.weight = nn.Parameter(torch.tensor([.6, -.8], dtype=torch.float64))
+        self.register_buffer("context", torch.tensor([.2, -.3], dtype=torch.float64))
+
+    def forward(self, x, context=None):
+        context = self.context if context is None else context
+        logits = (x * self.weight + context).sin().sum(-1)
+        return logits, x.square().sum(-1)
+
+
+def fixture():
+    critic = ContextCritic()
+    controller = ReversiblePrecision(critic, variant="rp5")
+    with torch.no_grad():
+        critic.weight.add_(torch.tensor([.15, -.25], dtype=torch.float64))
+    real = torch.tensor([[.1, -.2], [.7, .4]], dtype=torch.float64)
+    return critic, controller, real
+
+
+def assert_state_equal(a, b):
+    assert a["state"] == b["state"]
+    assert a["reference"].keys() == b["reference"].keys()
+    assert all(torch.equal(a["reference"][k], b["reference"][k]) for k in a["reference"])
+
+
+def analytic_gap(critic, reference, real, context):
+    live = critic.weight.detach() * (real * critic.weight.detach() + context).cos()
+    ref = reference.weight.detach() * (real * reference.weight.detach() + context).cos()
+    return float((live - ref).square().mean())
+
+
+def test_scratch_source_is_used_and_default_matches_explicit_direct_probe():
+    assert Path(particlegan.__file__).resolve().parent == Path(__file__).resolve().parents[1] / "particlegan"
+    critic, direct, real = fixture()
+    bound = deepcopy(direct)
+    direct.observe(critic, real, .125)
+    bound.observe(critic, real, .125, probe=lambda module, x: module(x))
+    assert_state_equal(direct.state_dict(), bound.state_dict())
+
+
+def test_conditional_gap_matches_analytic_input_gradients_and_current_context():
+    critic, controller, real = fixture()
+    contexts = [torch.tensor([[1.2, -.4], [-.7, .9]], dtype=real.dtype),
+                torch.tensor([[-.3, 1.7], [.4, -.5]], dtype=real.dtype)]
+    for context in contexts:
+        expected = analytic_gap(critic, controller.reference, real, context)
+        wrong_context = analytic_gap(critic, controller.reference, real, controller.reference.context)
+        assert abs(expected - wrong_context) > 1e-5
+        calls = []
+
+        def probe(module, x):
+            calls.append((module, x.detach().clone(), context.clone()))
+            return module(x, context)
+
+        controller.observe(critic, real, .125, probe=probe)
+        assert controller.state["gap"] == pytest.approx(expected, rel=1e-14, abs=1e-16)
+        assert calls[0][0] is critic and calls[1][0] is controller.reference
+        assert torch.equal(calls[0][1], real) and torch.equal(calls[1][1], real)
+        assert torch.equal(calls[0][2], context) and torch.equal(calls[1][2], context)
+    assert controller.state["updates"] == 2
+
+
+def test_probe_leaves_caller_input_context_and_parameter_gradients_untouched():
+    critic, controller, real = fixture()
+    real.requires_grad_()
+    real.grad = torch.full_like(real, 7.)
+    context = torch.tensor([1.3, -.9], dtype=real.dtype, requires_grad=True)
+    context.grad = torch.full_like(context, 8.)
+    critic.weight.grad = torch.full_like(critic.weight, 9.)
+    saved = [t.detach().clone() for t in (real, context, critic.weight)]
+    controller.observe(critic, real, .2, probe=lambda module, x: module(x, context))
+    for tensor, old, grad in zip((real, context, critic.weight), saved, (7., 8., 9.)):
+        assert torch.equal(tensor, old)
+        assert torch.equal(tensor.grad, torch.full_like(tensor, grad))
+
+
+def test_checkpoint_continuation_rebinds_context_without_serializing_callable():
+    critic, controller, real = fixture()
+    first_context = torch.tensor([1., -.5], dtype=real.dtype)
+    controller.observe(critic, real, .3, probe=lambda module, x: module(x, first_context))
+    saved = controller.state_dict()
+    assert set(saved) == {"state", "reference"}
+    resumed = ReversiblePrecision(critic, variant="rp5")
+    resumed.load_state_dict(saved)
+    with torch.no_grad():
+        critic.weight.add_(.05)
+    next_context = torch.tensor([-.8, .9], dtype=real.dtype)
+    controller.observe(critic, real, .2, probe=lambda module, x: module(x, next_context))
+    resumed.observe(critic, real, .2, probe=lambda module, x: module(x, next_context))
+    assert_state_equal(controller.state_dict(), resumed.state_dict())
+
+
+def test_noncallable_probe_rejected_before_state_mutation():
+    critic, controller, real = fixture()
+    saved = controller.state_dict()
+    with pytest.raises(TypeError, match="probe must be callable or None"):
+        controller.observe(critic, real, .1, probe=object())
+    assert_state_equal(controller.state_dict(), saved)
