diff --git a/tests/test_dv7_component_rates.py b/tests/test_dv7_component_rates.py
new file mode 100644
--- /dev/null
+++ b/tests/test_dv7_component_rates.py
@@ -0,0 +1,149 @@
+"""CPU rate/controller contracts only: no forward, backward or optimizer step."""
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+import torch
+from torch import nn
+
+import particlegan
+from particlegan import (
+    DataDriftController, GANTrainer, NetworkLRTransition, get_recipe,
+    learning_rate_scales, scale_learning_rates,
+)
+
+
+def recipe():
+    return get_recipe(total_steps=None, continuous_policy="dv7", input_noise_std=0.,
+                      output_noise_warmup=0., num_particles=8, z_dim=2, batch_size=4)
+
+
+def fixture():
+    trainer = GANTrainer(recipe(), nn.Linear(2, 2), nn.Linear(2, 1),
+                         optimizer_options={"foreach": False, "fused": False}, serial_backward=True)
+    return trainer, (trainer.opt_g, trainer.opt_d), deepcopy(trainer.initial_lrs)
+
+
+def rates(optimizers):
+    return [[g["lr"] for g in opt.param_groups] for opt in optimizers]
+
+
+def set_controller(controller, mobility, trust, error):
+    state = controller.state_dict()
+    state.update(mobility=mobility, game_trust=trust, payoff_error=error)
+    controller.load_state_dict(state)
+
+
+@pytest.mark.parametrize("mobility,trust,error,expected", [
+    (1., .75, 2., (.75, .75, .2)),
+    (0., .5, .5, (.005, .025, .8)),
+])
+@pytest.mark.parametrize("parameter_binding", [False, True])
+def test_three_roles_match_trainer_arithmetic_and_do_not_compound(mobility, trust, error, expected, parameter_binding):
+    assert Path(particlegan.__file__).resolve().parent == Path(__file__).resolve().parents[1] / "particlegan"
+    trainer, optimizers, base = fixture()
+    set_controller(trainer.controller, mobility, trust, error)
+    saved = trainer.controller.state_dict()
+    network, prior, critic = expected
+    binding = tuple(trainer.D.parameters()) if parameter_binding else trainer.D
+    for step in (0, 7000, 10**9):
+        assert scale_learning_rates(step, trainer.recipe, optimizers, base, trainer.prior,
+                                    controller=trainer.controller, critic=binding) == (network, prior)
+        assert rates(optimizers) == [[base[0][0] * network, base[0][1] * prior],
+                                     [base[1][0] * network * critic]]
+    assert trainer.controller.state_dict() == saved
+    assert trainer.completed_steps == 0
+    assert all(not opt.state for opt in optimizers)
+
+
+def test_restored_controller_reproduces_all_rates_and_reopening_resets_from_base():
+    trainer, optimizers, base = fixture()
+    set_controller(trainer.controller, 0., .5, .5)
+    saved = trainer.controller.state_dict()
+    restored = DataDriftController("dv7")
+    restored.load_state_dict(saved)
+    for controller in (trainer.controller, restored):
+        scale_learning_rates(123, trainer.recipe, optimizers, base, trainer.prior,
+                             controller=controller, critic=trainer.D)
+        assert rates(optimizers) == [[base[0][0] * .005, base[0][1] * .025],
+                                     [base[1][0] * .005 * .8]]
+    assert restored.current_scales() == trainer.controller.current_scales()
+    assert restored.critic_scale() == trainer.controller.critic_scale()
+    set_controller(restored, 1., 1., 0.)
+    scale_learning_rates(124, trainer.recipe, optimizers, base, trainer.prior,
+                         controller=restored, critic=trainer.D)
+    assert rates(optimizers) == base
+
+
+@pytest.mark.parametrize("kind,message", [
+    ("missing_controller", "matching controller"),
+    ("wrong_controller_type", "matching controller"),
+    ("wrong_variant", "matching controller"),
+    ("missing_critic", "require critic="),
+    ("foreign_critic", "critic optimizer"),
+    ("wrong_generator_role", "critic optimizer"),
+    ("partial_critic", "complete nonempty groups"),
+    ("overlapping_prior", "roles overlap"),
+    ("empty_critic", "nonempty optimized parameters"),
+    ("missing_group_rate", "every optimizer group"),
+    ("missing_optimizer_rate", "every optimizer"),
+    ("network_transition", "scheduled network transitions"),
+])
+def test_invalid_binding_fails_before_any_lr_mutation(kind, message):
+    trainer, optimizers, base = fixture()
+    set_controller(trainer.controller, 0., .5, 2.)
+    options = dict(controller=trainer.controller, critic=trainer.D)
+    if kind == "missing_controller": options["controller"] = None
+    if kind == "wrong_controller_type": options["controller"] = object()
+    if kind == "wrong_variant": options["controller"] = DataDriftController("dv6")
+    if kind == "missing_critic": options["critic"] = None
+    if kind == "foreign_critic": options["critic"] = nn.Linear(2, 1)
+    if kind == "wrong_generator_role": options["critic"] = trainer.G
+    if kind == "partial_critic": options["critic"] = [trainer.D.weight]
+    if kind == "overlapping_prior": options["critic"] = list(trainer.D.parameters()) + list(trainer.prior.parameters())
+    if kind == "empty_critic": options["critic"] = []
+    if kind == "missing_group_rate": base[1] = []
+    if kind == "missing_optimizer_rate": base = base[:1]
+    if kind == "network_transition": options["network_transition"] = NetworkLRTransition(5)
+    before = rates(optimizers)
+    with pytest.raises(ValueError, match=message):
+        scale_learning_rates(100, trainer.recipe, optimizers, base, trainer.prior, **options)
+    assert rates(optimizers) == before
+
+
+def test_plain_adam_mixed_and_foreign_roles_are_rejected_atomically():
+    generator, critic, prior = nn.Linear(2, 2), nn.Linear(2, 1), nn.Embedding(8, 2)
+    controller = DataDriftController("dv7")
+    mixed = torch.optim.Adam(list(generator.parameters()) + list(critic.parameters()), lr=.01)
+    for binding, message in ((critic, "complete nonempty groups"),
+                             (nn.Linear(2, 1), "must all belong")):
+        with pytest.raises(ValueError, match=message):
+            scale_learning_rates(0, recipe(), (mixed,), ([.01],), controller=controller, critic=binding)
+        assert rates((mixed,)) == [[.01]]
+    critic_opt = torch.optim.Adam(critic.parameters(), lr=.02)
+    mixed_prior = torch.optim.Adam(list(generator.parameters()) + list(prior.parameters()), lr=.01)
+    with pytest.raises(ValueError, match="prior parameters must occupy complete groups"):
+        scale_learning_rates(0, recipe(), (critic_opt, mixed_prior), ([.02], [.01]), prior,
+                             controller=controller, critic=critic)
+    assert rates((critic_opt, mixed_prior)) == [[.02], [.01]]
+
+
+@pytest.mark.parametrize("step,expected", [(0, (1., 1.)), (10, (.2, 1.)), (15, (.2, .55)), (20, (.2, .1))])
+def test_finite_recipe_behavior_and_network_transition_remain_available(step, expected):
+    finite = get_recipe(total_steps=20, network_lr_horizon_cap=10,
+                        lr_anneal_start=.5, lr_floor=.1, network_lr_floor=.2)
+    generator, prior = nn.Linear(2, 2), nn.Embedding(8, 2)
+    optimizer = torch.optim.Adam([{"params": generator.parameters(), "lr": .01},
+                                  {"params": prior.parameters(), "lr": .02}])
+    assert scale_learning_rates(step, finite, (optimizer,), ([.01, .02],), prior) == pytest.approx(expected)
+    assert rates((optimizer,))[0] == pytest.approx([.01 * expected[0], .02 * expected[1]])
+    transition = NetworkLRTransition(4, start_step=8)
+    assert learning_rate_scales(10, finite, network_transition=transition) == pytest.approx((.6, 1.))
+
+
+def test_older_continuous_policy_keeps_its_symmetric_binding_contract():
+    old = get_recipe(total_steps=None, continuous_policy="dv6")
+    optimizer = torch.optim.Adam(nn.Linear(2, 1).parameters(), lr=.01)
+    controller = DataDriftController("dv6")
+    assert scale_learning_rates(10**9, old, (optimizer,), ([.01],), controller=controller) == (1., 1.)
+    assert rates((optimizer,)) == [[.01]]
