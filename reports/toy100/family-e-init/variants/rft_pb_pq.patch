+def test_host_zero_after_reset_is_kept():
+    uninstall()
+    install("exp_bz_pq")
+    layer = nn.Linear(4, 4, bias=False)
+    nn.init.zeros_(layer.weight)
+    torch.optim.Adam(layer.parameters(), lr=1e-3)
+    assert torch.equal(layer.weight, torch.zeros_like(layer.weight))
