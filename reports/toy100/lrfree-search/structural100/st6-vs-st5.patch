+    def _extragradient(self, real, generator_real, collect_stats):
+        """Transactional adaptive extragradient, with one committed optimizer step.
+
+        The predictor uses the existing optimizer including its safeguards.
+        Its moments, KA2 anchor/record, A2 history, controller, random streams,
+        and module buffers are discarded. Only predicted parameters survive
+        until corrector gradients have been evaluated. The corrector starts
+        again from the original optimizer state, so Adam/AMSGrad denominators
+        are adaptive rather than the fixed metric of elementary EG theory.
+        """
+        # Host data cursors are outside checkpoints: consume a callback once.
+        real_g = generator_real() if callable(generator_real) else generator_real
+        real_g = real if real_g is None else self._batch(real_g, "generator_real")
+        if real_g.shape != real.shape:
+            raise ValueError("generator_real must match the real batch shape")
+        parameters = [p for opt in (self.opt_g, self.opt_d)
+                      for group in opt.param_groups for p in group["params"]]
+        original = [p.detach().clone() for p in parameters]
+        checkpoint = self.state_dict()
+        roots = (self.G, self.D, self.prior, self.ema_G, self.ema_prior, self.ema_D)
+        modes = [(m, m.training) for root in roots if root is not None
+                 for m in root.modules()]
+        # Module checkpoints exclude nonpersistent buffers. Roll those back too.
+        buffers = [(b, b.detach().clone()) for root in roots if root is not None
+                   for b in root.buffers()]
+        old_collect_stats = self.penalty.collect_stats
+        old_input_sigma = self._noisy_D.std
+        last_sigma = self.last_output_sigma
+        penalty_stats = deepcopy(self.penalty.last_stats)
+        critic_identity = self.penalty.regularizer._critic_id
+        try:
+            self._joint_gradients(real, real_g, False)
+            self.opt_d.step()
+            self.opt_g.step()
+            predicted = [p.detach().clone() for p in parameters]
+            self.load_state_dict(checkpoint)
+            for module, training in modes:
+                module.training = training
+            with torch.no_grad():
+                for buffer, value in buffers:
+                    buffer.copy_(value)
+            self.penalty.collect_stats = old_collect_stats
+            self._noisy_D.std = old_input_sigma
+            self.last_output_sigma = last_sigma
+            self.penalty.last_stats = penalty_stats
+            self.penalty.regularizer._critic_id = critic_identity
+            with torch.no_grad():
+                for p, value in zip(parameters, predicted):
+                    p.copy_(value)
+            result = self._joint_gradients(real, real_g, collect_stats)
+            # Keep corrector gradients and once-evaluated buffers/controller;
+            # optimizer steps must be based at the ORIGINAL parameter point.
+            with torch.no_grad():
+                for p, value in zip(parameters, original):
+                    p.copy_(value)
+            self.opt_d.step()
+            self.opt_g.step()
