+"""Training-data-only EM for a separate sampling calibration.
+
+One update at generator stationarity, then hold sampling masses and width until
+a subsequent optimizer reopen/settle transition and a fresh real reservoir.
+Five latent-jitter subcomponents approximate each row's conditional law.
+No task labels, evaluator observations, clock schedule, or fitted LR enters.
+"""
+import math
+import time
+
+import torch
+
+
+class RowMixtureEM:
+    CAPACITY = 16384
+    SUBCOMPONENTS = 5
+    SETTLED_SCALE = 1. / 64.
+
+    def __init__(self, trainer, seed):
+        self.stream = torch.Generator(device=trainer.device).manual_seed(seed)
+        self.reservoir = None
+        self.fill = self.cursor = self.rows_since_fit = self.fits = 0
+        self.armed = True
+        self.committed = False
+        self.sampling_sigma = None
+        self.reopens = 0
+        self.last = {}
+
+    @property
+    def active(self):
+        return self.committed
+
+    @torch.no_grad()
+    def reopen(self, trainer):
+        """A detected real-law change returns control to the original learner."""
+        if not self.active:
+            return
+        for prior in (trainer.prior, trainer.ema_prior):
+            prior.row_weights.fill_(1. / prior.num_particles)
+            prior.row_weights_active.fill_(False)
+        self.reservoir = None
+        self.fill = self.cursor = self.rows_since_fit = 0
+        self.armed = True
+        self.committed = False
+        self.sampling_sigma = None
+        self.reopens += 1
+        self.last = dict(step=trainer.completed_steps + 1, event='reopen', reopens=self.reopens)
+
+    @torch.no_grad()
+    def observe_real(self, real):
+        x = real.detach().flatten(1)
+        if self.reservoir is None:
+            self.reservoir = x.new_zeros(self.CAPACITY, x.shape[1])
+        count = len(x)
+        x = x[-self.CAPACITY:]
+        first = min(len(x), self.CAPACITY - self.cursor)
+        self.reservoir[self.cursor:self.cursor + first] = x[:first]
+        self.reservoir[:len(x) - first] = x[first:]
+        self.cursor = (self.cursor + len(x)) % self.CAPACITY
+        self.fill = min(self.CAPACITY, self.fill + len(x))
+        self.rows_since_fit += count
+
+    def _settled(self, trainer):
+        scales = [tester.s for group, role, tester in zip(
+            trainer.opt_g.param_groups, trainer.roles[0], trainer.lr_settle.testers[0])
+            if role == 'generator' and not group.get('sigma_group') and tester is not None]
+        return bool(scales) and min(scales) <= self.SETTLED_SCALE
+
+    @torch.no_grad()
+    def maybe_apply(self, trainer):
+        if not self._settled(trainer):
+            self.armed = True
+            return None
+        if (not self.armed or self.fill < self.CAPACITY
+                or self.rows_since_fit < self.CAPACITY):
+            return None
+        modes = [(m, m.training) for m in trainer.G.modules()]
+        devices = [trainer.device.index] if trainer.device.type == 'cuda' else []
+        try:
+            trainer.G.eval()
+            with torch.random.fork_rng(devices=devices):
+                return self._fit(trainer)
+        finally:
+            for module, training in modes:
+                module.training = training
+
+    @torch.no_grad()
+    def _fit(self, trainer):
+        import numpy as np
+        from scipy.spatial import cKDTree
+
+        started = time.monotonic()
+        n = trainer.prior.num_particles
+        sigma = trainer.output_sigma()
+        if not math.isfinite(sigma) or sigma <= 0:
+            raise ValueError('row EM requires positive finite Gaussian output sigma')
+        clean = []
+        for _ in range(self.SUBCOMPONENTS):
+            for z in trainer.prior.z.split(2048):
+                latent = (trainer.controller.perturb_latent(z, self.stream, trainer.prior)
+                          if trainer.controller is not None else z)
+                clean.append(trainer.G(latent).flatten(1).cpu().double().numpy())
+        clean = np.concatenate(clean)
+        d = clean.shape[1]
+        ids = np.tile(np.arange(n), self.SUBCOMPONENTS)
+        old_weights = trainer.prior.row_weights.detach().cpu().double().numpy()
+        old_weights = old_weights / old_weights.sum()
+        component_weights = old_weights[ids] / self.SUBCOMPONENTS
+        positive = component_weights > 0
+        clean, ids, component_weights = clean[positive], ids[positive], component_weights[positive]
+        real = self.reservoir.cpu().double().numpy()
+        tree = cKDTree(clean)
+        near, near_index = tree.query(real, k=1, workers=2)
+        # Bound omitted Gaussian mass relative to the retained nearest term
+        # by float64 epsilon, including nonuniform component weights.
+        cutoff = -math.log(np.finfo(np.float64).eps) - np.log(component_weights[near_index])
+        radius = np.sqrt(near ** 2 + 2 * sigma ** 2 * cutoff)
+        counts = tree.query_ball_point(real, radius, workers=2, return_length=True)
+        pair_budget = max(1, min(2 ** 18, 2 ** 21 // d))
+        cumulative = np.concatenate(([0], np.cumsum(counts)))
+        row_mass = np.zeros(n)
+        residual = 0.
+        old_nll = 0.
+        begin = 0
+        while begin < len(real):
+            end = min(len(real), max(begin + 1, int(np.searchsorted(
+                cumulative, cumulative[begin] + pair_budget, side='right')) - 1))
+            x = real[begin:end]
+            neighbors = tree.query_ball_point(x, radius[begin:end], workers=2)
+            ii = np.repeat(np.arange(len(x)), counts[begin:end])
+            jj = np.concatenate(neighbors)
+            delta = clean[jj] - x[ii]
+            distance2 = np.einsum('ij,ij->i', delta, delta)
+            logp = np.log(component_weights[jj]) - distance2 / (2 * sigma ** 2)
+            maximum = np.full(len(x), -np.inf)
+            np.maximum.at(maximum, ii, logp)
+            p = np.exp(logp - maximum[ii])
+            total = np.bincount(ii, weights=p, minlength=len(x))
+            responsibility = p / total[ii]
+            row_mass += np.bincount(ids[jj], weights=responsibility, minlength=n)
+            residual += float(np.dot(responsibility, distance2))
+            old_nll += float((d / 2 * math.log(2 * math.pi * sigma ** 2)
+                              - maximum - np.log(total)).sum())
+            begin = end
+        weights = row_mass / len(real)
+        # Numerical positivity only: no statistical or task-dependent floor.
+        numerical_tiny = torch.finfo(trainer.dtype).tiny
+        new_sigma = math.sqrt(max(residual / (len(real) * d), numerical_tiny))
+        weights = np.maximum(weights, numerical_tiny)
+        if (not np.isfinite(weights).all() or weights.sum() <= 0
+                or not math.isfinite(new_sigma) or new_sigma <= 0):
+            raise ValueError('nonfinite or degenerate row EM update')
+        weights /= weights.sum()
+        value = torch.as_tensor(weights, device=trainer.device, dtype=trainer.dtype)
+        for prior in (trainer.prior, trainer.ema_prior):
+            prior.row_weights.copy_(value)
+            prior.row_weights_active.fill_(True)
+        self.sampling_sigma = new_sigma
+        self.committed = True
+        self.armed = False
+        self.rows_since_fit = 0
+        self.fits += 1
+        self.last = dict(step=trainer.completed_steps + 1, fit=self.fits,
+                         sigma_before=sigma, sigma_after=new_sigma,
+                         effective_rows=float(1. / np.dot(weights, weights)),
+                         real_rows=len(real), subcomponents=self.SUBCOMPONENTS,
+                         old_fit_nll=old_nll / len(real),
+                         trigger='first_settle' if self.fits == 1 else 'resettle',
+                         seconds=time.monotonic() - started)
+        return dict(self.last)
+
+    def state_dict(self):
+        return dict(reservoir=self.reservoir, fill=self.fill, cursor=self.cursor,
+                    rows_since_fit=self.rows_since_fit, fits=self.fits,
+                    armed=self.armed, committed=self.committed,
+                    sampling_sigma=self.sampling_sigma, reopens=self.reopens,
+                    last=dict(self.last), stream=self.stream.get_state())
+
+    def check_state(self, state, trainer):
+        if not isinstance(state, dict) or state.keys() != self.state_dict().keys():
+            raise ValueError('invalid row EM state')
+        for key in ('fill', 'cursor', 'rows_since_fit', 'fits', 'reopens'):
+            if type(state[key]) is not int or state[key] < 0:
+                raise ValueError('invalid row EM counter')
+        if state['fill'] > self.CAPACITY or state['cursor'] >= self.CAPACITY:
+            raise ValueError('invalid row EM reservoir cursor')
+        reservoir = state['reservoir']
+        if type(state['armed']) is not bool or type(state['committed']) is not bool:
+            raise ValueError('invalid row EM phase flag')
+        if state['committed']:
+            if (not state['fits'] or not isinstance(state['sampling_sigma'], (int, float))
+                    or not math.isfinite(state['sampling_sigma']) or state['sampling_sigma'] <= 0):
+                raise ValueError('invalid row EM sampling sigma')
+        elif state['sampling_sigma'] is not None:
+            raise ValueError('unexpected row EM sampling sigma')
+        if reservoir is not None and (not isinstance(reservoir, torch.Tensor)
+                or reservoir.ndim != 2 or len(reservoir) != self.CAPACITY
+                or reservoir.dtype != trainer.dtype or not torch.isfinite(reservoir).all()):
+            raise ValueError('invalid row EM reservoir')
+        if (state['committed'] or state['fill']) and reservoir is None:
+            raise ValueError('missing row EM reservoir')
+        if not isinstance(state['last'], dict):
+            raise ValueError('invalid row EM diagnostics')
+        torch.Generator(device=trainer.device).set_state(state['stream'].cpu())
+
+    def load_state_dict(self, state, trainer):
+        self.check_state(state, trainer)
+        for key in ('reservoir',):
+            value = state[key]
+            setattr(self, key, None if value is None else value.clone().to(trainer.device))
+        for key in ('fill', 'cursor', 'rows_since_fit', 'fits', 'armed', 'committed', 'sampling_sigma', 'reopens'):
+            setattr(self, key, state[key])
+        self.last = dict(state['last'])
+        self.stream.set_state(state['stream'].cpu())
