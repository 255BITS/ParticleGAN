diff --git a/reports/toy100/constant-lr-dynamics/sitecustomize.py b/reports/toy100/constant-lr-dynamics/sitecustomize.py
new file mode 100644
index 00000000..8658ff3d
--- /dev/null
+++ b/reports/toy100/constant-lr-dynamics/sitecustomize.py
@@ -0,0 +1,15 @@
+"""Install shared_batch before the probe captures Adam.step.
+
+Flag: K3P_DYNAMICS=shared_batch. Unset does nothing (constant-LR K3P).
+Put this directory on PYTHONPATH. The branch screen does that.
+"""
+import os
+import sys
+
+name = os.environ.get("K3P_DYNAMICS")
+if name == "shared_batch":
+    from particlegan.dynamics.shared_batch import install
+    install()
+elif name:
+    sys.stderr.write(f"this patch only installs shared_batch, got {name}\n")
+    raise SystemExit(2)
