+"""Install unit_rms before the probe captures Adam.step.
+
+Flag: K3P_DYNAMICS=unit_rms. Unset does nothing (constant-LR K3P).
+Put this directory on PYTHONPATH. The branch screen does that.
+"""
+import os
+import sys
+
+name = os.environ.get("K3P_DYNAMICS")
+if name == "unit_rms":
+    from particlegan.dynamics.unit_rms import install
+    install()
+elif name:
+    sys.stderr.write(f"this patch only installs unit_rms, got {name}\n")
+    raise SystemExit(2)
