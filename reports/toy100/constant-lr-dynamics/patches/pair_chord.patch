@@ -0,0 +1,15 @@
+"""Install pair_chord before the probe captures Adam.step.
+
+Flag: K3P_DYNAMICS=pair_chord. Unset does nothing (constant-LR K3P).
+Put this directory on PYTHONPATH. The branch screen does that.
+"""
+import os
+import sys
+
+name = os.environ.get("K3P_DYNAMICS")
+if name == "pair_chord":
+    from particlegan.dynamics.pair_chord import install
+    install()
+elif name:
+    sys.stderr.write(f"this patch only installs pair_chord, got {name}\n")
+    raise SystemExit(2)
